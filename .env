# 1Rad API Configuration
# Change this to http://localhost:5090/api/v1 for local development
VITE_API_URL=http://151.185.45.77:5000/api/v1
VITE_APP_URL=http://151.185.45.77:80

# Mapbox token for the centre-location map picker in Hospital Settings. This
# ships inside the client-side JS bundle, so it must be a token scoped to
# ONLY the default public scopes (styles:read, fonts:read, datasets:read,
# vision:read) — create one at https://account.mapbox.com/access-tokens/
# with no other scopes checked. A pk. prefix alone does NOT guarantee this;
# GitHub's push protection rejected an earlier pk. token here for carrying
# secret-level scopes.
VITE_MAPBOX_TOKEN=REPLACE_WITH_A_PUBLIC_SCOPED_MAPBOX_TOKEN
